{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口与托盘悬浮卡所需的权限：事件监听、窗口操作、打开外部链接、系统通知",
  "windows": ["main", "tray"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "opener:default",
    "notification:default"
  ]
}
